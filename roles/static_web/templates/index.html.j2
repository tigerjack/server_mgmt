<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Welcome to {{ web_domain }}">
    <title>{{ web_domain }}</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }

        :root {
            --bg: #0f1117;
            --surface: #1a1d27;
            --border: #2a2d3d;
            --text: #e2e8f0;
            --muted: #94a3b8;
            --accent: #6366f1;
            --accent-hover: #818cf8;
        }

        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                         "Helvetica Neue", Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 1rem;
            padding: 3rem 4rem;
            max-width: 640px;
            width: 100%;
            text-align: center;
            box-shadow: 0 4px 32px rgba(0,0,0,0.4);
        }

        .logo {
            font-size: 3rem;
            margin-bottom: 1rem;
            line-height: 1;
        }

        h1 {
            font-size: 2rem;
            font-weight: 700;
            margin: 0 0 0.5rem;
            letter-spacing: -0.025em;
        }

        p {
            color: var(--muted);
            line-height: 1.7;
            margin: 0 0 2rem;
        }

        .services {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .service-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.6rem 1.2rem;
            background: transparent;
            border: 1px solid var(--border);
            border-radius: 0.5rem;
            color: var(--text);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            transition: border-color 0.2s, color 0.2s;
        }

        .service-link:hover {
            border-color: var(--accent-hover);
            color: var(--accent-hover);
        }

        footer {
            margin-top: 3rem;
            color: var(--muted);
            font-size: 0.8rem;
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="logo">&#9728;</div>
        <h1>{{ web_domain }}</h1>
        <p>Self-hosted services running on this server.</p>

        <nav class="services">
{% if nextcloud_domain is defined %}
            <a href="https://{{ nextcloud_domain }}" class="service-link">
                &#9729; Nextcloud
            </a>
{% endif %}
{% if forgejo_domain is defined %}
            <a href="https://{{ forgejo_domain }}" class="service-link">
                &#9998; Forgejo
            </a>
{% endif %}
        </nav>
    </div>

    <footer>
        Served by nginx &middot; Proxied by Traefik &middot; {{ web_domain }}
    </footer>
</body>
</html>
