# Traefik Podman Quadlet container unit
# Managed by Ansible - do not edit manually
# Location: /etc/containers/systemd/traefik.container

[Unit]
Description=Traefik Reverse Proxy
Documentation=https://doc.traefik.io/traefik/
After=network-online.target podman.socket.service
Wants=network-online.target

[Container]
Image={{ traefik_image }}
ContainerName=traefik

# Bind mounts
Volume={{ container_base_dir }}/traefik/traefik.yml:/traefik.yml:ro,z
Volume={{ container_base_dir }}/traefik/data:/data:z
Volume={{ container_base_dir }}/traefik/logs:/logs:z
Volume={{ container_base_dir }}/traefik/config:/config:ro,z
Volume=/run/podman/podman.sock:/var/run/podman/podman.sock:ro,z

# Network
Network={{ podman_network_name }}.network

# Port bindings (host ports)
PublishPort=80:80
PublishPort=443:443
PublishPort=2222:2222

# Security: Traefik needs to bind low ports, run as root inside container
# The container itself is managed by the root systemd instance (rootful podman)
SecurityLabelDisable=true

# Traefik command - point at our static config
Exec=--configFile=/traefik.yml

# Resource limits
PodmanArgs=--memory=512m --cpus=1.0

# Labels for Traefik to expose its own dashboard (disabled by default, enable if needed)
Label=traefik.enable=false

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target default.target
