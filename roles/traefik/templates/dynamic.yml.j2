# Traefik dynamic configuration - file provider
# Managed by Ansible - do not edit manually
# Container-level routing is handled via Docker provider labels on each container.
# This file defines shared middleware and any static routes.

http:
  middlewares:
    # Redirect HTTP to HTTPS (also set at entrypoint level, belt-and-suspenders)
    https-redirect:
      redirectScheme:
        scheme: https
        permanent: true

    # Security headers applied to all services
    secure-headers:
      headers:
        sslRedirect: true
        forceSTSHeader: true
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        stsPreload: true
        contentTypeNosniff: true
        browserXssFilter: true
        referrerPolicy: "strict-origin-when-cross-origin"
        permissionsPolicy: "camera=(), microphone=(), geolocation=()"
        customResponseHeaders:
          X-Robots-Tag: "noindex, nofollow"
          server: ""

    # Rate limiting for auth endpoints
    rate-limit-auth:
      rateLimit:
        average: 10
        burst: 20
        period: 1m

    # Compress responses
    compress:
      compress:
        excludedContentTypes:
          - text/event-stream

# TLS options
tls:
  options:
    default:
      minVersion: VersionTLS12
      cipherSuites:
        - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305
        - TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305
      sniStrict: true
