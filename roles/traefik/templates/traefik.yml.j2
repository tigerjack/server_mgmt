# Traefik v3 static configuration
# Managed by Ansible - do not edit manually

global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: "{{ traefik_log_level }}"
  filePath: "/logs/traefik.log"
  format: json

accessLog:
  filePath: "/logs/access.log"
  format: json
  bufferingSize: 100
  fields:
    defaultMode: keep
    headers:
      defaultMode: drop
      names:
        User-Agent: keep
        Authorization: drop

api:
  dashboard: false
  insecure: false

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true

  websecure:
    address: ":443"
    http:
      tls:
        certResolver: letsencrypt
    http2:
      maxConcurrentStreams: 250

  # Forgejo SSH passthrough (TCP)
  forgejo-ssh:
    address: ":2222"

certificatesResolvers:
  letsencrypt:
    acme:
      email: "{{ traefik_acme_email }}"
      storage: "/data/acme.json"
{% if traefik_acme_production %}
      caServer: "https://acme-v02.api.letsencrypt.org/directory"
{% else %}
      # Let's Encrypt STAGING - safe for testing, issues untrusted certs
      caServer: "https://acme-staging-v02.api.letsencrypt.org/directory"
{% endif %}
      tlsChallenge: {}

providers:
  # Docker/Podman socket provider - reads container labels
  docker:
    endpoint: "unix:///var/run/podman/podman.sock"
    exposedByDefault: false
    network: "{{ podman_network_name }}"
    watch: true

  # File provider - static routes and middleware defined in dynamic.yml
  file:
    directory: "/config"
    watch: true

serversTransport:
  insecureSkipVerify: false
