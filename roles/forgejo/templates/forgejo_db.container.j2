# Forgejo PostgreSQL Podman Quadlet container unit
# Managed by Ansible - do not edit manually
# Location: /etc/containers/systemd/forgejo_db.container

[Unit]
Description=Forgejo PostgreSQL Database
After=network-online.target
Wants=network-online.target

[Container]
Image={{ forgejo_db_image }}
ContainerName={{ forgejo_db_container_name }}

# Persistent storage
Volume={{ forgejo_db_dir }}:/var/lib/postgresql/data:z

# Network
Network={{ podman_network_name }}.network

# Database credentials
Environment=POSTGRES_DB={{ forgejo_db_name }}
Environment=POSTGRES_USER={{ forgejo_db_user }}
Environment=POSTGRES_PASSWORD={{ forgejo_db_password }}

# PostgreSQL tuning for a small Forgejo instance
Environment=POSTGRES_INITDB_ARGS=--encoding=UTF8 --lc-collate=C --lc-ctype=C

# Resource limits
PodmanArgs=--memory=256m

# Traefik: do not route database traffic
Label=traefik.enable=false

[Service]
Restart=always
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target default.target
