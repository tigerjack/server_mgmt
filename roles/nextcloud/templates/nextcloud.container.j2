# Nextcloud Podman Quadlet container unit
# Managed by Ansible - do not edit manually
# Location: /etc/containers/systemd/nextcloud.container

[Unit]
Description=Nextcloud Application Server
After=network-online.target nextcloud_db.service nextcloud_redis.service
Requires=nextcloud_db.service nextcloud_redis.service
Wants=network-online.target

[Container]
Image={{ nextcloud_image }}
ContainerName={{ nextcloud_container_name }}

# Persistent storage
Volume={{ nextcloud_data_dir }}:/var/www/html:z
Volume={{ nextcloud_config_dir }}/custom-php.ini:/usr/local/etc/php/conf.d/custom.ini:ro,z

# Network
Network={{ podman_network_name }}.network

# Database connection
Environment=MYSQL_HOST={{ nextcloud_db_container_name }}
Environment=MYSQL_DATABASE={{ nextcloud_db_name }}
Environment=MYSQL_USER={{ nextcloud_db_user }}
Environment=MYSQL_PASSWORD={{ nextcloud_db_password }}

# Nextcloud auto-install on first run
Environment=NEXTCLOUD_ADMIN_USER={{ nextcloud_admin_user }}
Environment=NEXTCLOUD_ADMIN_PASSWORD={{ nextcloud_admin_password }}
Environment=NEXTCLOUD_TRUSTED_DOMAINS={{ nextcloud_domain }}

# Redis
Environment=REDIS_HOST={{ nextcloud_redis_container_name }}
{% if nextcloud_redis_password %}
Environment=REDIS_HOST_PASSWORD={{ nextcloud_redis_password }}
{% endif %}

# PHP settings via env
Environment=PHP_MEMORY_LIMIT={{ nextcloud_php_memory_limit }}
Environment=PHP_UPLOAD_LIMIT={{ nextcloud_php_upload_limit }}

# Resource limits
PodmanArgs=--memory=1g

# Traefik routing labels
Label=traefik.enable=true
Label=traefik.http.routers.nextcloud.rule=Host(`{{ nextcloud_domain }}`)
Label=traefik.http.routers.nextcloud.entrypoints=websecure
Label=traefik.http.routers.nextcloud.tls=true
Label=traefik.http.routers.nextcloud.tls.certresolver=letsencrypt
Label=traefik.http.routers.nextcloud.middlewares=secure-headers@file,nextcloud-dav,nextcloud-hsts
Label=traefik.http.services.nextcloud.loadbalancer.server.port=80
Label=traefik.http.services.nextcloud.loadbalancer.healthcheck.path=/status.php
Label=traefik.http.services.nextcloud.loadbalancer.healthcheck.interval=60s
# Nextcloud CalDAV/CardDAV redirect middleware
Label=traefik.http.middlewares.nextcloud-dav.redirectregex.permanent=true
Label=traefik.http.middlewares.nextcloud-dav.redirectregex.regex=https://(.*)/.well-known/(?:card|cal)dav
Label=traefik.http.middlewares.nextcloud-dav.redirectregex.replacement=https://$${1}/remote.php/dav
# HSTS middleware specific to Nextcloud
Label=traefik.http.middlewares.nextcloud-hsts.headers.stsSeconds=15552000
Label=traefik.http.middlewares.nextcloud-hsts.headers.stsIncludeSubdomains=true
Label=traefik.http.middlewares.nextcloud-hsts.headers.stsPreload=true
Label=traefik.http.middlewares.nextcloud-hsts.headers.forceSTSHeader=true

[Service]
Restart=always
RestartSec=10s
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target default.target
