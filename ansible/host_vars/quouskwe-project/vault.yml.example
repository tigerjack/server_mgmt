---
# HOST-SPECIFIC encrypted vault for quouskwe-project.
#
# Copy to vault.yml in this same directory and encrypt it:
#   cp vault.yml.example vault.yml
#   ansible-vault encrypt vault.yml
# Edit later with:
#   ansible-vault edit vault.yml
#
# Everything here is loaded ONLY for the quouskwe-project host. Each instance
# (spqr-project, ...) gets its own host_vars/<host>/vault.yml with its
# own users and secrets — they never see each other's values.
#
# vault.yml and .vault_pass are gitignored and must NEVER be committed.

# ---------------------------------------------------------------------------
# Forgejo
# ---------------------------------------------------------------------------
# Internal MariaDB credentials for the Forgejo database container.
# vault_forgejo_db_root_password: root password for the MariaDB instance
#   (only used for administrative SQL access, not by Forgejo itself)
# vault_forgejo_db_password: password for the "forgejo" database user
#   (used by the Forgejo container to connect to its database)
# Generate both with: openssl rand -hex 32
vault_forgejo_db_root_password: ""
vault_forgejo_db_database:       "forgejo"
vault_forgejo_db_user:           "forgejo"
vault_forgejo_db_password:       ""

# Forgejo application admin account (created on first run, idempotent after).
# This is a LOCAL Forgejo account used purely for CLI administration — it
# never logs in via Authelia/OIDC and exists as a break-glass fallback.
#
# IMPORTANT: this username MUST differ from your personal Authelia username.
# When you sign in via Authelia for the first time, Forgejo creates a new
# account tied to your OIDC identity. If a local account with the same
# username already exists, Forgejo refuses the link with "account already
# exists" and you cannot log in via SSO.
#
# Use a neutral service name here (e.g. "forgejo-admin") and log in to the
# Forgejo web UI with your own username only via the Authelia portal.
#
# Generate the password with: openssl rand -base64 32
vault_forgejo_admin_user:        "forgejo-admin"
vault_forgejo_admin_password:    ""
vault_forgejo_admin_email:       "forgejo-admin@quouskwe-project.deib.polimi.it"

# ---------------------------------------------------------------------------
# Nextcloud
# ---------------------------------------------------------------------------
# Internal MariaDB credentials for the Nextcloud database container.
# vault_nextcloud_db_root_password: root password for the MariaDB instance
# vault_nextcloud_db_password: password for the "nextcloud" database user
# Generate both with: openssl rand -hex 32
vault_nextcloud_db_root_password: ""
vault_nextcloud_db_database:      "nextcloud"
vault_nextcloud_db_user:          "nextcloud"
vault_nextcloud_db_password:      ""

# Nextcloud application admin account (created on first run, idempotent after).
# This user gets the "admin" role inside Nextcloud.
# It is distinct from any Authelia user — regular users log in via OIDC, but
# the admin account is a local fallback if OIDC breaks.
vault_nextcloud_admin_user:       "admin"
vault_nextcloud_admin_password:   ""

# ---------------------------------------------------------------------------
# Collabora Online
# ---------------------------------------------------------------------------
# Admin credentials for the Collabora built-in admin panel (/lool/adminws).
# Not exposed to users — only used for server-side administration.
vault_collabora_admin_user:     "admin"
vault_collabora_admin_password: ""

# ---------------------------------------------------------------------------
# EuroOffice Document Server
# ---------------------------------------------------------------------------
# JWT secret shared between the EuroOffice container and the Nextcloud
# richdocuments app. Both sides must have the same value — it is used to
# sign and verify document-open requests. Not a password; generate with:
#   openssl rand -hex 32
# Do NOT share this value across instances.
vault_eurooffice_jwt_secret: ""

# ---------------------------------------------------------------------------
# SMTP relay (leave blank if not using authenticated SMTP)
# ---------------------------------------------------------------------------
# Credentials for the outbound SMTP relay (e.g. Brevo).
# vault_smtp_user:     your relay login / account email
# vault_smtp_password: SMTP API key or relay password
vault_smtp_user:     ""
vault_smtp_password: ""

# ---------------------------------------------------------------------------
# Authelia secrets
# ---------------------------------------------------------------------------
# Four independent random 256-bit secrets. Each serves a different internal
# purpose; they must all be unique. Generate each with: openssl rand -hex 32
#
# vault_authelia_session_secret:         signs the browser session cookie
# vault_authelia_storage_encryption_key: encrypts Authelia's SQLite database
#   (TOTP secrets, WebAuthn keys, remember-me tokens)
# vault_authelia_jwt_secret:             signs password-reset tokens
# vault_authelia_oidc_hmac_secret:       used in OIDC token derivation (HMAC)
vault_authelia_session_secret:         ""
vault_authelia_storage_encryption_key: ""
vault_authelia_jwt_secret:             ""
vault_authelia_oidc_hmac_secret:       ""

# OIDC issuer signing key — RSA 4096-bit private key in PEM format.
#
# Authelia uses this key to sign the JWT tokens it issues to Nextcloud and
# Forgejo after a successful login. Each app verifies the signature against
# the corresponding public key, which Authelia publishes automatically at
# https://<domain>/auth/.well-known/jwks.json.
#
# Generate once per instance (do NOT share this key across instances — each
# server must have its own):
#   openssl genrsa 4096
#
# Paste the entire output (including BEGIN/END lines) here, preserving the
# block-scalar style (the leading | and two-space indent on every line):
vault_authelia_oidc_jwks_key: |
  -----BEGIN PRIVATE KEY-----
  ...paste the whole PEM here, indented by two spaces...
  -----END PRIVATE KEY-----

# ---------------------------------------------------------------------------
# OIDC client secrets (one matched pair per app)
# ---------------------------------------------------------------------------
# Each app registered as an OIDC client needs a shared secret. Authelia stores
# only the hash; the plaintext goes to the app. Generate a matched pair with:
#
#   podman run --rm docker.io/authelia/authelia:4.39 \
#     authelia crypto hash generate pbkdf2 --variant sha512 --random --random.length 48
#
# The command prints two lines:
#   Random Password: <PLAINTEXT>   → *_client_secret     (goes to the app)
#   Digest:          <HASH>        → *_client_secret_hash (stays in Authelia)
#
# Run it twice: once for Forgejo, once for Nextcloud.
#
# Forgejo — used by the "authelia" OAuth2 source inside Forgejo's admin panel
vault_oidc_forgejo_client_secret:        ""
vault_oidc_forgejo_client_secret_hash:   ""
# Nextcloud — used by the user_oidc app inside Nextcloud
vault_oidc_nextcloud_client_secret:      ""
vault_oidc_nextcloud_client_secret_hash: ""

# ---------------------------------------------------------------------------
# Authelia users (THIS instance's approved logins)
# ---------------------------------------------------------------------------
# Only users listed here can log in. There is no self-service registration.
# Adding an entry and re-running the playbook is the approval step.
#
# Fields:
#   username:      login name (must be unique, lowercase recommended)
#   displayname:   shown in Authelia's portal UI
#   email:         where password-reset links are sent (MUST be correct — the
#                  password-reset link goes here; wrong email = user is locked out)
#   password_hash: argon2 hash of the user's initial password (see below)
#   groups:        list of groups; "admins" grants admin access in Nextcloud
#
# IMPORTANT: the password field must be a valid argon2/bcrypt hash. An empty
# string or a non-hash value causes Authelia to fail to parse users_database.yml
# and refuse to start, locking everyone out. Always set a real hash, even if it
# is only a throwaway.
#
# Recommended first-login flow:
# 1. Generate a hash for a throwaway password (share it out-of-band with the user):
#      podman run --rm docker.io/authelia/authelia:4.39 \
#        authelia crypto hash generate argon2 --password 'ChangeMe123!'
# 2. Put that hash here, deploy.
# 3. The user logs in with the throwaway password, then either:
#    a. Uses "Forgot my password" at https://<domain>/auth (requires SMTP) to
#       set their own password — they never need to share it with you.
#    b. Or you harvest the new hash from /etc/authelia/users_database.yml after
#       they reset it via the portal, and update this vault entry.
# 4. For SMTP-less hosts: the user must change their password through the portal
#    UI (Settings → Change password) while still logged in with the throwaway.
authelia_users:
  - username: "sperriello"
    displayname: "Stefano Perriello"
    email: "sperriello@proton.me"
    password_hash: "$argon2id$v=19$..."
    groups: [admins]
