---
# Global vault — shared across ALL hosts.
#
# Copy to vault.yml and encrypt:
#   cp group_vars/all/vault.yml.example group_vars/all/vault.yml
#   ansible-vault encrypt group_vars/all/vault.yml
# Edit later with:
#   ansible-vault edit group_vars/all/vault.yml
#
# Keep this file small. Only put values here that are genuinely the same on
# every host. Everything else belongs in host_vars/<host>/vault.yml.

# Let's Encrypt registration email — used for expiry notifications only,
# not exposed to any service.
acme_email: "you@example.com"
